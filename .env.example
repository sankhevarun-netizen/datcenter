# K-Nexus environment. Copy to .env.local for development; in staging and
# production set these in the platform's secret store (Vercel environment
# variables, or Azure Key Vault referenced from App Service settings) — never
# commit values.

# Supabase (auth, audit trail, persistence, knowledge graph)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Model and retrieval
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
# Optional: semantic embeddings for the knowledge graph (falls back to a local lexical embedding)
VOYAGE_API_KEY=
# Optional: second news source for external risk
EXA_API_KEY=

# Access control
# true on every deployment a client can reach: every page and API needs a session
AUTH_REQUIRED=false
# true to hide email/password sign-in and allow Microsoft single sign-on only
NEXT_PUBLIC_SSO_ONLY=false
# Role for callers without a session while AUTH_REQUIRED=false (operator | manager | partner | admin)
NEXUS_OPEN_ACCESS_ROLE=manager

# Local store when Supabase is unreachable (defaults to ~/.k-nexus; /tmp on Vercel)
NEXUS_DATA_DIR=

# Knowledge graph filesystem fallback (defaults outside the repository: ~/.k-nexus/wiki)
WIKI_PATH=
# Only for scripts/wiki-migrate.mjs --supabase (bulk load); never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
